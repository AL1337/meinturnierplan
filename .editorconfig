# Editor settings for the MeinTurnierplan plugin. The codebase uses 2-space indentation.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.txt]
trim_trailing_whitespace = false
